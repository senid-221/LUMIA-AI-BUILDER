generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum ProjectStatus { DRAFT PLANNING BUILDING TESTING READY FAILED }
enum TaskType { PLAN WEB_APP BACKEND DATABASE PROMPT CODE TEST DEBUG DEPLOY }
enum TaskStatus { PENDING RUNNING DONE FAILED }
enum ExecutionStatus { RUNNING PASSED FAILED }
model User { id String @id @default(cuid()) email String @unique passwordHash String name String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt sessions Session[] projects BuilderProject[] }
model Session { id String @id @default(cuid()) tokenHash String @unique userId String expiresAt DateTime createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId]) @@index([expiresAt]) }
model BuilderProject { id String @id @default(cuid()) name String description String? status ProjectStatus @default(DRAFT) stack Json? ownerId String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt owner User? @relation(fields:[ownerId],references:[id],onDelete:SetNull) files BuilderFile[] tasks BuilderTask[] executions BuilderExecution[] @@index([ownerId]) }
model BuilderFile { id String @id @default(cuid()) projectId String path String content String language String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt project BuilderProject @relation(fields:[projectId],references:[id],onDelete:Cascade) @@unique([projectId,path]) }
model BuilderTask { id String @id @default(cuid()) projectId String type TaskType title String status TaskStatus @default(PENDING) input Json? output Json? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt project BuilderProject @relation(fields:[projectId],references:[id],onDelete:Cascade) }
model BuilderExecution { id String @id @default(cuid()) projectId String command String status ExecutionStatus @default(RUNNING) stdout String? stderr String? exitCode Int? createdAt DateTime @default(now()) finishedAt DateTime? project BuilderProject @relation(fields:[projectId],references:[id],onDelete:Cascade) }
